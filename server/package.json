{
  "name": "@bomberman/server",
  "version": "1.0.0",
  "description": "Serveur de jeu Node.js & WebSockets",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "cd ../shared && npm run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "pretest": "cd ../shared && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bomberman/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2"
  },
  "license": "ISC"
}
