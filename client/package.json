{
  "name": "@bomberman/client",
  "version": "1.0.0",
  "description": "Client de bureau Bomberman Arena (Electron, TypeScript, PixiJS)",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:electron",
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@bomberman/shared": "*",
    "pixi.js": "^8.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "electron": "^34.2.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "license": "ISC"
}
